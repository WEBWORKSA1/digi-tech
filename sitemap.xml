---
layout: null
permalink: /sitemap.xml
---
<?xml version='1.0' encoding='UTF-8'?>
<urlset xmlns='http://www.sitemaps.org/schemas/sitemap/0.9'>
{%- for p in site.pages -%}
{%- assign last = p.url | slice: -1 -%}
{%- if last == '/' and p.noindex != true %}
  <url><loc>{{ site.url }}{{ p.url }}</loc></url>
{%- endif -%}
{%- endfor -%}
{%- for t in site.tools %}
  <url><loc>{{ site.url }}{{ t.url }}</loc></url>
{%- endfor -%}
{%- for g in site.guides %}
  <url><loc>{{ site.url }}{{ g.url }}</loc><lastmod>{{ g.updated | date: '%Y-%m-%d' }}</lastmod></url>
{%- endfor %}
</urlset>
